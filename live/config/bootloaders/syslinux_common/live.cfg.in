label live-@FLAVOUR@
	menu label ^Live system (@FLAVOUR@)
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-@FLAVOUR@-failsafe
	menu label Live system (@FLAVOUR@ fail-safe mode)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@

label live-@FLAVOUR@-nvidia
	menu label Universe OS - NVIDIA-stuurprogramma
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ universe.gpu=nvidia

label live-@FLAVOUR@-veilig
	menu label Universe OS - veilige grafische modus
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ universe.gpu=veilig universe.gfx=safe vga=791

label live-@FLAVOUR@-nomodeset
	menu label Universe OS - nomodeset (noodgeval)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ nomodeset universe.gpu=veilig universe.gfx=safe
