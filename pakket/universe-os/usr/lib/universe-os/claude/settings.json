    "Notification": [{"hooks": [{"type": "command", "command": "/usr/lib/universe-os/claude/universe-claude-hook", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "/usr/lib/universe-os/claude/universe-claude-hook", "timeout": 3}]}]
