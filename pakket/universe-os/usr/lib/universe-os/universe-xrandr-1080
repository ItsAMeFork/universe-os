#!/bin/sh
# LightDM display-setup-script (X only, e.g. nomodeset/Xorg fallback): 1920x1080 on every connected output that
# offers it; other screens keep their preferred mode. Always exit 0: a failing script stops the login screen.
command -v xrandr >/dev/null 2>&1 || exit 0
xrandr --query 2>/dev/null | awk '
 /^[^ ]/ {out = ($2 == "connected") ? $1 : ""; next}
 /^ +1920x1080 / && out != "" {print out; out=""}
' | while read -r out; do xrandr --output "$out" --mode 1920x1080 >/dev/null 2>&1; done
exit 0
