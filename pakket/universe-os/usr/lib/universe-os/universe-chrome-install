#!/bin/sh
# Installs Google Chrome from Google's own package source on the first start with internet (choice of Axel, 6 Oct
# 2026, also on a metered connection). Chrome itself is not in the ISO: Google's terms do not clearly allow us to
# redistribute it. Run as root by universe-chrome-install.timer until Chrome is installed; never in the live session.
# Afterwards Chrome keeps its own source and key up to date (google-chrome.sources, /usr/share/keyrings).
# State for the interface: /var/lib/universe-os/chrome.json  {"state": offline|installing|installed|error, ...}
set -u
STATE_DIR=/var/lib/universe-os
STATE=$STATE_DIR/chrome.json
LOG=/var/log/universe-chrome-install.log
KEY=/usr/share/keyrings/google-chrome.gpg
SOURCES=/etc/apt/sources.list.d/google-chrome.sources

status() {
    mkdir -p "$STATE_DIR"
    printf '{"state": "%s", "message": "%s", "at": %s}\n' "$1" "$2" "$(date +%s)" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    chmod 0644 "$STATE"
}

[ -d /run/live ] && exit 0
if [ -x /usr/bin/google-chrome-stable ]; then
    status installed 'Google Chrome is geïnstalleerd.'
    exit 0
fi
if ! nm-online -q -t 60; then
    status offline 'Google Chrome wordt gedownload zodra er internet is.'
    exit 0
fi

status installing 'Google Chrome wordt gedownload en geïnstalleerd.'
# Same key and source file as Chrome's own postinst writes, so Chrome takes them over without a duplicate source.
# The key was checked on fingerprint EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796 (Google Linux Packages Signing Authority).
install -Dm644 /usr/share/universe-os/google-chrome.gpg "$KEY"
[ -f "$SOURCES" ] || cat >"$SOURCES" <<SRC
X-Repolib-Name: Google Chrome
Types: deb
URIs: https://dl.google.com/linux/chrome-stable/deb/
Suites: stable
Components: main
Architectures: amd64
Signed-By: $KEY
SRC

export DEBIAN_FRONTEND=noninteractive
{
    echo "== $(date -Is)"
    apt-get -o DPkg::Lock::Timeout=600 update &&
        apt-get -o DPkg::Lock::Timeout=600 install -y google-chrome-stable
} >>"$LOG" 2>&1
if [ -x /usr/bin/google-chrome-stable ]; then
    status installed 'Google Chrome is geïnstalleerd.'
else
    # The timer tries again later; downloaded parts stay in the apt cache.
    status error 'Google Chrome downloaden of installeren is mislukt; het wordt later opnieuw geprobeerd.'
    exit 1
fi
