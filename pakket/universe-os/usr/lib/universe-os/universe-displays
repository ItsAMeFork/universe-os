#!/usr/bin/python3
"""Screens: list outputs (wlr-randr --json) and apply the scale saved per screen in the Universe settings.

  universe-displays list            JSON list of screens
  universe-displays apply           apply saved scales (at login)
  universe-displays resolution      standard resolution 1920x1080 where the screen has it (first thing at login)
  universe-displays scale NAME S    set and save scale S for screen NAME
"""
import json
import subprocess
import sys
import time

sys.path.insert(0, '/usr/lib/universe-os/shell')
import config  # noqa: E402


def outputs():
    try:
        data = json.loads(subprocess.run(['wlr-randr', '--json'], capture_output=True, text=True, timeout=5).stdout or '[]')
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    result = []
    for o in data:
        mode = next((m for m in o.get('modes', []) if m.get('current')), {})
        result.append({'name': o.get('name'), 'description': o.get('description', ''), 'enabled': o.get('enabled', True),
                       'scale': o.get('scale', 1.0), 'width': mode.get('width'), 'height': mode.get('height'),
                       'refresh': round(mode.get('refresh', 0) or 0, 1)})
    return result


def _preferred_missing():
    """Screens stuck on an emergency mode while a bigger preferred mode exists. In the VM (virtio-gpu) the screen
    reports 640x480 while the session starts and the real size a moment later; labwc keeps the first mode, so the whole
    session stayed at 640x480 (14 Oct). Only such small modes (at most 1024 wide) are changed: a mode a real pc runs is
    never touched, because every mode change makes the whole screen redraw (16 Oct: the Earth went blank after it)."""
    try:
        data = json.loads(subprocess.run(['wlr-randr', '--json'], capture_output=True, text=True, timeout=5).stdout or '[]')
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    names = []
    for o in data:
        modes = o.get('modes', [])
        pref = next((m for m in modes if m.get('preferred')), None)
        cur = next((m for m in modes if m.get('current')), None)
        if (o.get('enabled', True) and pref and cur and cur['width'] <= 1024
                and pref['width'] * pref['height'] > cur['width'] * cur['height']):
            names.append(o.get('name'))
    return names


DEFAULT_RESOLUTION = '1920x1080'


def choose_mode(modes, target):
    """The mode to switch to: target ('WxH') with the highest refresh, or None (screen lacks it, already on it, or
    target 'preferred'). Jesse, 23 Oct: 1920x1080 as standard; screens without it keep their preferred mode."""
    try:
        w, h = (int(x) for x in str(target).lower().split('x'))
    except ValueError:
        return None
    fits = [m for m in modes if m.get('width') == w and m.get('height') == h]
    if not fits or any(m.get('current') for m in fits):
        return None
    return max(fits, key=lambda m: m.get('refresh') or 0)


def resolution():
    """Before the shell draws anything: a mode change later made the whole screen redraw (16 Oct)."""
    target = config.settings().get('displayResolution') or DEFAULT_RESOLUTION
    try:
        data = json.loads(subprocess.run(['wlr-randr', '--json'], capture_output=True, text=True, timeout=5).stdout or '[]')
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return
    changed = []
    for o in data:
        mode = o.get('enabled', True) and choose_mode(o.get('modes', []), target)
        if mode:
            subprocess.run(['wlr-randr', '--output', o['name'], '--mode',
                            '%dx%d@%.3f' % (mode['width'], mode['height'], mode.get('refresh') or 60)], check=False, timeout=10)
            changed.append((o['name'], mode['width'], mode['height']))
    settle(changed)


def settle(changed, timeout=4.0):
    """Wait until the new modes are really on screen (NVIDIA takes a moment) plus one second, so the shell starts at the
    final size: a size change under a running world page froze it on the H310M (23 Oct)."""
    if not changed:
        return
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        now = {o['name']: (o['width'], o['height']) for o in outputs()}
        if all(now.get(n) == (w, h) for n, w, h in changed):
            break
        time.sleep(0.25)
    time.sleep(1.0)


def apply():
    # The preferred mode can arrive a few seconds after login: check a few times, then stop.
    for attempt in range(6):
        for name in _preferred_missing():
            subprocess.run(['wlr-randr', '--output', name, '--preferred'], check=False, timeout=10)
        if attempt < 5:
            time.sleep(1.5)
    scales = config.settings().get('displayScales') or {}
    for o in outputs():
        if o['name'] in scales and abs(scales[o['name']] - o['scale']) > 0.01:
            subprocess.run(['wlr-randr', '--output', o['name'], '--scale', str(scales[o['name']])], check=False)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'list'
    if cmd == 'list':
        print(json.dumps(outputs()))
    elif cmd == 'apply':
        apply()
    elif cmd == 'resolution':
        resolution()
    elif cmd == 'scale' and len(sys.argv) == 4:
        name, scale = sys.argv[2], float(sys.argv[3])
        if not 0.5 <= scale <= 3:
            sys.exit('Schaal moet tussen 0,5 en 3 liggen')
        r = subprocess.run(['wlr-randr', '--output', name, '--scale', str(scale)])
        if r.returncode:
            sys.exit(r.returncode)
        scales = dict(config.settings().get('displayScales') or {})
        scales[name] = scale
        config.set_setting('displayScales', scales)
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
