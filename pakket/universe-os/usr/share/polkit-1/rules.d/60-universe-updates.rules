// Universe OS: de knop "Updates installeren" en de controle bij inloggen mogen universe-updates.service starten zonder
// wachtwoord, maar alleen deze ene unit en alleen vanuit een actieve lokale sessie. De taak installeert uitsluitend
// updates uit de ingestelde (ondertekende) bronnen.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "universe-updates.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "restart") &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
