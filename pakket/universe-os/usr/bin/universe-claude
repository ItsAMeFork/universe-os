#!/bin/sh
# Starts the unmodified Claude Code for the Claude panel: Haiku by default, the Universe tools (universe-mcp), the
# hooks for the buddy and a short explanation of Universe OS. --nieuw starts a new conversation.
D=/usr/lib/universe-os/claude
CLAUDE=$(command -v claude || true)
for p in "$HOME/.local/bin/claude" "$HOME/.claude/local/claude"; do
    [ -z "$CLAUDE" ] && [ -x "$p" ] && CLAUDE=$p
done
if [ -z "$CLAUDE" ]; then
    echo "Claude Code is nog niet geïnstalleerd."
    echo "Installeer het in het Controlecentrum, of in een terminal met:"
    echo "  curl -fsSL https://claude.ai/install.sh | bash"
    printf "Druk op Enter om te sluiten. "
    read -r _
    exit 1
fi
cd "$HOME" || exit 1
CONTINUE=
# Continue the last conversation in the home folder if there is one (Claude Code names its folder after the path).
if [ "$1" != "--nieuw" ] && ls "$HOME/.claude/projects/$(printf %s "$HOME" | sed 's/[^A-Za-z0-9]/-/g')"/*.jsonl >/dev/null 2>&1; then
    CONTINUE=--continue
fi
export UNIVERSE_CLAUDE=1
exec "$CLAUDE" --model haiku $CONTINUE --mcp-config "$D/mcp.json" --settings "$D/settings.json" \
    --append-system-prompt "$(cat "$D/uitleg.md")"
