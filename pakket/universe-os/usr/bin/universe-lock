#!/bin/sh
# Lock the screen (Windows+L, panel, idle, before sleep). swaylock uses PAM: the normal account password.
# --indicator-idle-visible: without it swaylock shows only the dark colour until a key is pressed, which looks like a black,
# frozen screen. The ring now always shows where the password goes; Caps Lock is shown too.
# Background: the Earth in space with "Vergrendeld" (scripts/assets/vergrendeld.png, like the login screen). swaylock stays the
# secure lock (ext-session-lock) and keeps the session running; the ring sits on top of the planet.
pgrep -u "$(id -u)" -x gtklock >/dev/null && exit 0
pgrep -u "$(id -u)" -x swaylock >/dev/null && exit 0
# Animation (Axel, 10 Oct): the desktop is first pulled into the Earth that the lock screen shows, then swaylock
# starts; the shell brings the desktop back out after unlocking. --direct (before sleep): lock at once.
# 0.2.38: the lock animation (world.js animateWorld 'out', stars stretching into light streaks) takes 2.3 s.
# 'universe-ctl lock' comes first: the shell catches the keyboard at once (keys typed during the animation used to
# reach the app in front, 0.2.38 live test), only then the sound.
ANIM=
[ "$1" != "--direct" ] && ANIM=$(universe-ctl lock 2>/dev/null)
[ "$1" != "--direct" ] && universe-geluid vergrendelen
[ "$ANIM" = "ok anim" ] && sleep 2.3
# 0.3.3 (Axel, 28 Oct: "dan moet de gebruiker ook op dezelfde inlogvenster"): every lock (Windows+L, menu, idle,
# sleep, assistant) shows the login screen with the planets, the same as at start-up. The lock below stays the real
# protection of this session: once it holds, universe-wissel switches to the greeter, where the user's password
# brings him back (LightDM -> logind Unlock -> universe-ontgrendel-wacht ends the lock). Should the switch fail, the
# lock screen itself is still there. universe-wissel sets UNIVERSE_LOCK_ZONDER_INLOGSCHERM: it switches itself.
if [ -z "${UNIVERSE_LOCK_ZONDER_INLOGSCHERM:-}" ] && command -v universe-wissel >/dev/null 2>&1; then
    (
        i=0  # only once the lock really runs, at most 3 s; otherwise stay on the lock screen
        while [ "$i" -lt 30 ] && ! pgrep -u "$(id -u)" -x 'gtklock|swaylock' >/dev/null; do
            sleep 0.1
            i=$((i + 1))
        done
        pgrep -u "$(id -u)" -x 'gtklock|swaylock' >/dev/null && exec universe-wissel
    ) >/dev/null 2>&1 &
fi
# gtklock (12 Oct, Axel: "like the login screen, with the user name, and the user types his password"): the Earth in
# space, a glass card with the picture and name of the user, a real password field and the time (style.css). It is a
# secure lock as well (ext-session-lock: if it crashed, the screen stays locked). swaylock below is the fallback.
if command -v gtklock >/dev/null 2>&1; then
    MOD=$(ls /usr/lib/*/gtklock/userinfo-module.so 2>/dev/null | head -1)
    # 0.3.0: the buttons "Andere gebruiker" and "Afmelden" (package universe-os-vergrendelknoppen), when installed.
    KNOP=$(ls /usr/lib/*/gtklock/universe-knoppen-module.so 2>/dev/null | head -1)
    # Not exec: after unlocking the unlock sound plays (gtklock stays in the foreground until then).
    # 0.3.0: labwc 0.8.3 unlocks the session when the lock client dies, so a gtklock that crashed or was killed is
    # started again at once. Only a real unlock (exit 0 after PAM) or the logind Unlock after the greeter
    # (universe-ontgrendel-wacht, marker below) ends the loop.
    MARK="${XDG_RUNTIME_DIR:-/tmp}/universe-ontgrendeld"
    rm -f "$MARK"
    # 0.3.5 (Axel, 28 Oct: "heel kort de oude inlog interface"): when the login screen takes over (universe-wissel,
    # always since 0.3.3), gtklock shows only the glowing core (stil.css) and its card only after 8 s as an emergency
    # way back; no idle hiding (-H), which would restart that delay. Without universe-wissel: the full lock screen.
    STIJL=/usr/share/universe-os/gtklock/style.css
    VERBERG="-H -T 30"
    if command -v universe-wissel >/dev/null 2>&1 && [ -f /usr/share/universe-os/gtklock/stil.css ]; then
        STIJL=/usr/share/universe-os/gtklock/stil.css
        VERBERG=
    fi
    SNEL=0
    while :; do
        T0=$(date +%s)
        # $VERBERG unquoted on purpose: zero or two words.
        gtklock -s "$STIJL" -x /usr/share/universe-os/gtklock/layout.ui ${MOD:+-m "$MOD"} \
            ${KNOP:+-m "$KNOP"} -t "%H:%M" -D "%A %e %B" $VERBERG && break
        [ -e "$MARK" ] && break
        # A module that crashes gtklock at once must never leave the user locked out: after two quick failures
        # the lock runs without the button module (the lock itself stays).
        if [ $(( $(date +%s) - T0 )) -lt 3 ]; then SNEL=$((SNEL + 1)); else SNEL=0; fi
        [ "$SNEL" -ge 2 ] && KNOP=
        sleep 0.1
    done
    rm -f "$MARK"
    universe-geluid ontgrendelen
    exit 0
fi
IMAGE=/usr/share/universe-os/backgrounds/vergrendeld.png
set --
[ -r "$IMAGE" ] && set -- --image "$IMAGE" --scaling fill
exec swaylock -f "$@" \
    --color 050815 \
    --indicator-idle-visible --indicator-caps-lock \
    --indicator-radius 90 --indicator-thickness 9 \
    --inside-color 0b1021e6 --inside-clear-color 0b1021e6 --inside-ver-color 162335e6 --inside-wrong-color 3a1420e6 \
    --ring-color 85ffe355 --ring-ver-color 85ffe3 --ring-wrong-color ff8a9a --ring-clear-color baf7e8 \
    --key-hl-color 85ffe3 --bs-hl-color ff8a9a --line-color 00000000 --line-ver-color 00000000 --line-wrong-color 00000000 \
    --separator-color 00000000 --text-color e2e6fa --text-ver-color e2e6fa --text-wrong-color ffd0d6 \
    --font "Noto Sans" --show-failed-attempts --ignore-empty-password
