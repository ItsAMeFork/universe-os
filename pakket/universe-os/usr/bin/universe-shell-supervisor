#!/bin/sh
# Keeps the Universe shell running. If it crashes it is started again; open programs keep running because they are
# separate processes and windows of the compositor. After 5 crashes within 2 minutes it stops and offers recovery.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/universe-os"
mkdir -p "$STATE"
LOG="$STATE/shell.log"
crashes=0
# 0.2.39: new windows start hidden until the shell plays their portal. The watchdog shows them again (and stops hiding
# new ones) as soon as the shell heartbeat stops: crash, hang or a stopped shell never leaves windows hidden.
python3 /usr/lib/universe-os/shell/vensterwacht.py >>"$LOG" 2>&1 &
window_start=$(date +%s)
# Started from the labwc autostart: when labwc is gone (logged out) there is nothing to restart the shell for.
COMPOSITOR=$(pgrep -nu "$(id -u)" -x labwc || echo 0)
while :; do
    if ! kill -0 "$COMPOSITOR" 2>/dev/null || [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}" ]; then
        echo "--- compositor gestopt; shellbewaking stopt ($(date))" >>"$LOG"
        exit 0
    fi
    echo "--- shell start $(date)" >>"$LOG"
    universe-shell >>"$LOG" 2>&1
    code=$?
    echo "--- shell gestopt met code $code ($(date))" >>"$LOG"
    python3 /usr/lib/universe-os/shell/vensterwacht.py vrijgeven >>"$LOG" 2>&1
    now=$(date +%s)
    if [ $((now - window_start)) -gt 120 ]; then crashes=0; window_start=$now; fi
    crashes=$((crashes + 1))
    if [ "$crashes" -ge 5 ]; then
        notify-send -u critical "Universe OS" "De ruimtewereld blijft vastlopen. Er is een terminal geopend. Logboek: $LOG" 2>/dev/null
        xfce4-terminal --title "Universe OS herstel" -x sh -c "echo 'De Universe-shell start niet. Laatste regels van het logboek:'; tail -n 30 '$LOG'; echo; echo 'Probeer: universe-shell-supervisor &   of meld je af (labwc --exit).'; exec bash" &
        exit 1
    fi
    [ "$crashes" -gt 1 ] && notify-send "Universe OS" "De ruimtewereld wordt opnieuw gestart. Je programma's blijven open." 2>/dev/null
    sleep 1
done
