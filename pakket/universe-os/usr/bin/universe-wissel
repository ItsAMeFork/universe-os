#!/bin/sh
# "Andere gebruiker": lock this session at once, then show the login screen (LightDM greeter) on a new VT. The session
# of this user keeps running behind the lock (apps and windows stay), and can be resumed by logging in again as this user.
# Locking comes first so the session is never open to the next person while the greeter is up.
LOCKED='gtklock|swaylock'
locked() { pgrep -u "$(id -u)" -x "$LOCKED" >/dev/null 2>&1; }
if ! locked; then
    universe-lock --direct >/dev/null 2>&1 &
    # gtklock/swaylock take the session lock before their UI shows: wait for the process, at most 3 s
    i=0
    while [ "$i" -lt 30 ] && ! locked; do
        sleep 0.1
        i=$((i + 1))
    done
    locked || echo "universe-wissel: vergrendelen duurde te lang; toch naar het inlogscherm" >&2
fi
# 0.3.0 (Jesse: "soms alleen vergrendeld, geen greeter"): ask LightDM, then check that the greeter really became
# the active session of the seat; ask again (up to 5 times) when it did not. A request that LightDM drops (e.g. while
# the previous greeter is still shutting down) used to leave the user on his own lock screen.
greeter_actief() {
    s=$(loginctl show-seat seat0 -p ActiveSession --value 2>/dev/null) || return 1
    [ -n "$s" ] && [ "$(loginctl show-session "$s" -p Class --value 2>/dev/null)" = greeter ]
}
vraag() {  # 0 = asked, 1 = LightDM refused, 2 = no way to ask at all
    weg=2
    if command -v dm-tool >/dev/null 2>&1; then
        dm-tool switch-to-greeter 2>/dev/null && return 0
        weg=1
    fi
    if [ -n "${XDG_SEAT_PATH:-}" ] && command -v dbus-send >/dev/null 2>&1; then
        dbus-send --system --type=method_call --dest=org.freedesktop.DisplayManager "$XDG_SEAT_PATH" \
            org.freedesktop.DisplayManager.Seat.SwitchToGreeter 2>/dev/null && return 0
        weg=1
    fi
    return "$weg"
}
poging=1
while [ "$poging" -le 5 ]; do
    vraag
    rc=$?
    [ "$rc" -eq 2 ] && break
    if [ "$rc" -eq 0 ]; then
        i=0
        while [ "$i" -lt 40 ]; do  # at most 4 s per attempt
            greeter_actief && exit 0
            sleep 0.1
            i=$((i + 1))
        done
        echo "universe-wissel: poging $poging: inlogscherm niet actief geworden, opnieuw" >&2
    else
        echo "universe-wissel: poging $poging: LightDM gaf een fout" >&2
        sleep 1
    fi
    poging=$((poging + 1))
done
echo "universe-wissel: kon niet naar het inlogscherm wisselen" >&2
exit 1
