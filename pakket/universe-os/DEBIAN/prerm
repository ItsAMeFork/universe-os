#!/bin/sh
# Remove the bytecode that postinst made (compileall), so dpkg can remove or replace the shell folder cleanly.
set -e
if [ "$1" = "remove" ] || [ "$1" = "upgrade" ] || [ "$1" = "deconfigure" ]; then
    find /usr/lib/universe-os/shell /usr/lib/universe-os/claude -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true
fi
if [ "$1" = "remove" ] && [ -f /etc/pam.d/gtklock ]; then
    sed -i '/universe-lock-poging/d' /etc/pam.d/gtklock || true
    [ -f /etc/pam.d/sudo ] && sed -i '/universe-admin-geluid/d' /etc/pam.d/sudo || true
fi
exit 0
